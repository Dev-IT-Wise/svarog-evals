diff --git a/tests/test_backoff.py b/tests/test_backoff.py
index cd33b63..8d8b2f3 100644
--- a/tests/test_backoff.py
+++ b/tests/test_backoff.py
@@ -900,3 +900,27 @@ def test_event_log_levels(
 
     assert backoff_log_count == max_tries - 1
     assert giveup_log_count == 1
+
+
+def test_on_exception_exhausted_generator_raise_on_giveup_false():
+    giveups = []
+
+    @backoff.on_exception(backoff.constant, ValueError, interval=[0, 0],
+                          raise_on_giveup=False, on_giveup=giveups.append)
+    def boom():
+        raise ValueError("boom")
+
+    assert boom() is None
+    assert giveups[0]['tries'] == 3
+
+
+def test_on_predicate_exhausted_generator_giveup_has_value():
+    giveups = []
+
+    @backoff.on_predicate(backoff.constant, interval=[0, 0],
+                          on_giveup=giveups.append)
+    def falsy():
+        return 0
+
+    assert falsy() == 0
+    assert giveups[0]['value'] == 0
