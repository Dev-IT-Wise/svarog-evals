diff --git a/src/semver/version.py b/src/semver/version.py
index 75e73be..14037da 100644
--- a/src/semver/version.py
+++ b/src/semver/version.py
@@ -68,6 +68,18 @@ def _comparator(operator: Comparator) -> Comparator:
     return wrapper
 
 
+def split_prefix(version: str) -> Tuple[str, str]:
+    """
+    Split a leading "v" or "V", as git tags carry, from a version string.
+
+    :param version: the version string, with or without the prefix
+    :return: the prefix ("" when there is none) and the rest
+    """
+    if version[:1] in ("v", "V"):
+        return version[:1], version[1:]
+    return "", version
+
+
 def _cmp(a: T_cmp, b: T_cmp) -> int:
     """Return negative if a<b, zero if a==b, positive if a>b."""
     return (a > b) - (a < b)
