+@pytest.mark.parametrize(
+    "cli,expected",
+    [
+        (["bump", "patch", "v1.2.3"], "v1.2.4"),
+        (["bump", "minor", "V1.2.3"], "V1.3.0"),
+        (["nextver", "v1.2.3", "minor"], "v1.3.0"),
+        (["compare", "v1.2.3", "1.2.4"], "-1"),
+        (["compare", "1.2.3", "v1.2.3"], "0"),
+    ],
+)
+def test_should_accept_a_v_prefix(capsys, cli, expected):
+    assert main(cli) == 0
+    assert capsys.readouterr().out.strip() == expected
+
+
+def test_check_should_accept_a_v_prefix():
+    assert main(["check", "v1.2.3"]) == 0
