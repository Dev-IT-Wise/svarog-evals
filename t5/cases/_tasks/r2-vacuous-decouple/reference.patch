+def test_autoconfig_finds_env_next_to_the_calling_module(tmp_path, monkeypatch):
+    """
+    AutoConfig searches from the directory of the module that calls it,
+    whether the instance is called or its get() is. Nothing is patched: the
+    caller is a real module in a directory with its own .env.
+    """
+    import importlib.util
+    monkeypatch.delenv('T5_REGRESSION_KEY', raising=False)
+    (tmp_path / '.env').write_text('T5_REGRESSION_KEY=found\n')
+    (tmp_path / 'settings.py').write_text(
+        'from decouple import AutoConfig\n'
+        'VIA_CALL = AutoConfig()("T5_REGRESSION_KEY", default="missing")\n'
+        'VIA_GET = AutoConfig().get("T5_REGRESSION_KEY", default="missing")\n'
+    )
+    spec = importlib.util.spec_from_file_location('t5_settings', str(tmp_path / 'settings.py'))
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    assert (mod.VIA_CALL, mod.VIA_GET) == ('found', 'found')
