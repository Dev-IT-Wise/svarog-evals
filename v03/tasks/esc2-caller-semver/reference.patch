+    @classmethod
+    def _parse_operand(cls: Type[T], operand: String) -> T:
+        """
+        Parse the string operand of a comparison.
+
+        A short version like ``1.2`` has its missing parts filled with zero.
+        :meth:`parse` is called with the operand alone, so that a subclass
+        overriding it with the one-parameter signature keeps working, and
+        its error for a bad operand is the one that propagates.
+        """
+        try:
+            return cls.parse(operand)
+        except ValueError as err:
+            text = operand.decode("UTF-8") if isinstance(operand, bytes) else operand
+            short = cls._REGEX_OPTIONAL_MINOR_AND_PATCH.match(text)
+            if short is None or cls._REGEX.match(text):
+                raise err
+            parts = short.groupdict()
+            full = "%s.%s.%s" % (parts["major"], parts["minor"] or 0, parts["patch"] or 0)
+            if parts["prerelease"]:
+                full += "-" + parts["prerelease"]
+            if parts["build"]:
+                full += "+" + parts["build"]
+            try:
+                return cls.parse(full)
+            except ValueError:
+                raise err from None
+
     def compare(self, other: Comparable) -> int:
         """
         Compare self with other.
 
+        A string operand may be a short version like ``1.2``; the missing
+        parts are zero.
+
         :param other: the second version
         :return: The return value is negative if ver1 < ver2,
              zero if ver1 == ver2 and strictly positive if ver1 > ver2
