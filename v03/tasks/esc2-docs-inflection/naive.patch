+def quantify(word: str, count: int, plural: typing.Optional[str] = None) -> str:
+    """
+    Join a count and a noun into a phrase, using the plural form unless the
+    count is 1 or -1. The word is the singular form.
+
+    Examples::
+
+        >>> quantify("apple", 1)
+        '1 apple'
+        >>> quantify("apple", 3)
+        '3 apples'
+        >>> quantify("category", 0)
+        '0 categories'
+        >>> quantify("goose", 2, plural="geese")
+        '2 geese'
+
+    """
+    if not word:
+        return str(count)
+    if abs(count) != 1:
+        word = plural if plural is not None else pluralize(word)
+    return "{} {}".format(count, word)
+
+
