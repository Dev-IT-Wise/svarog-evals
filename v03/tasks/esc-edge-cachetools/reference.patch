         cache.timer.tick()  # past TTL
         self.assertNotIn(42, cache)
+
+
+class TTLReserveTest(unittest.TestCase):
+    def test_reserve_drops_expired_items_first(self):
+        timer = Timer()
+        cache = TTLCache(maxsize=3, ttl=2, timer=timer)
+        cache[1] = 1
+        timer.tick()
+        cache[2] = 2
+        cache[3] = 3
+        timer.tick()
+        cache.reserve(1)
+        self.assertEqual({2, 3}, set(cache))
