diff --git a/README.rst b/README.rst
index dd72500..f456346 100644
--- a/README.rst
+++ b/README.rst
@@ -51,6 +51,16 @@ fixed maximum size.  When the cache is full, i.e. by adding another
 item the cache would exceed its maximum size, the cache must choose
 which item(s) to discard based on a suitable `cache algorithm`_.
 
+To make room for a value before inserting it, call ``reserve(size)``.
+It evicts items, in the cache's own order, until ``size`` more units
+fit, and raises ``ValueError`` if ``size`` is negative or larger than
+``maxsize``, in which case nothing is evicted.
+
+.. code-block:: python
+
+   cache = LRUCache(maxsize=10, getsizeof=len)
+   cache.reserve(4)  # evicts least recently used items if needed
+
 This module provides multiple cache classes based on different cache
 algorithms, as well as decorators for easily memoizing function and
 method calls.
diff --git a/src/cachetools/__init__.py b/src/cachetools/__init__.py
index c9eecb2..551e9c2 100644
--- a/src/cachetools/__init__.py
+++ b/src/cachetools/__init__.py
@@ -152,6 +152,15 @@ class Cache(collections.abc.MutableMapping):
         self.__size.clear()
         self.__currsize = 0
 
+    def reserve(self, size):
+        """Evict items until a value of `size` fits, without inserting one."""
+        if size < 0:
+            raise ValueError("value size must be non-negative")
+        if size > self.maxsize:
+            raise ValueError("value too large")
+        while self.currsize + size > self.maxsize:
+            self.popitem()
+
     @property
     def maxsize(self):
         """The maximum size of the cache."""
