diff --git a/tests/__init__.py b/tests/__init__.py
index 2adcc63..c7cb015 100644
--- a/tests/__init__.py
+++ b/tests/__init__.py
@@ -42,6 +42,27 @@ class CacheTestMixin(_TestCaseProtocol):
         self.assertEqual(1, cache.getsizeof(0))
         self.assertTrue(repr(cache).startswith(cache.__class__.__name__))
 
+    def test_reserve(self):
+        cache = self.Cache(maxsize=4)
+        for i in range(4):
+            cache[i] = i
+        self.assertIsNone(cache.reserve(0))
+        self.assertEqual(4, len(cache))
+        cache.reserve(3)
+        self.assertEqual(1, cache.currsize)
+        cache.reserve(4)
+        self.assertEqual(0, len(cache))
+
+    def test_reserve_errors(self):
+        cache = self.Cache(maxsize=3)
+        cache[1] = 1
+        cache[2] = 2
+        with self.assertRaises(ValueError):
+            cache.reserve(4)
+        with self.assertRaises(ValueError):
+            cache.reserve(-1)
+        self.assertEqual(2, len(cache))
+
     def test_maxsize_negative(self):
         with self.assertRaises(ValueError):
             self.Cache(maxsize=-1)
diff --git a/tests/test_fifo.py b/tests/test_fifo.py
index e444609..c5cde4e 100644
--- a/tests/test_fifo.py
+++ b/tests/test_fifo.py
@@ -66,3 +66,19 @@ class FIFOCacheTest(unittest.TestCase, CacheTestMixin):
         self.assertEqual(cache[1], "updated")
         self.assertIn(3, cache)
         self.assertNotIn(2, cache)
+
+
+class FIFOReserveTest(unittest.TestCase):
+    def test_reserve_evicts_oldest_first(self):
+        cache = FIFOCache(maxsize=3)
+        cache.update({1: 1, 2: 2, 3: 3})
+        cache.reserve(2)
+        self.assertEqual({3}, set(cache))
+
+    def test_reserve_with_getsizeof(self):
+        cache = FIFOCache(maxsize=10, getsizeof=len)
+        cache["a"] = "xxxx"
+        cache["b"] = "yyyy"
+        cache.reserve(5)
+        self.assertEqual({"b"}, set(cache))
+        self.assertEqual(4, cache.currsize)
