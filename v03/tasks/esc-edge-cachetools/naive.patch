diff --git a/tests/__init__.py b/tests/__init__.py
index 2adcc63..8ebfc05 100644
--- a/tests/__init__.py
+++ b/tests/__init__.py
@@ -42,6 +42,24 @@ class CacheTestMixin(_TestCaseProtocol):
         self.assertEqual(1, cache.getsizeof(0))
         self.assertTrue(repr(cache).startswith(cache.__class__.__name__))
 
+    def test_reserve(self):
+        cache = self.Cache(maxsize=4)
+        for i in range(4):
+            cache[i] = i
+        cache.reserve(0)
+        self.assertEqual(4, len(cache))
+        cache.reserve(3)
+        self.assertEqual(1, cache.currsize)
+        cache.reserve(4)
+        self.assertEqual(0, len(cache))
+
+    def test_reserve_getsizeof(self):
+        cache = self.Cache(maxsize=10, getsizeof=len)
+        cache["a"] = "xxxx"
+        cache["b"] = "yyyy"
+        cache.reserve(5)
+        self.assertEqual(1, len(cache))
+
     def test_maxsize_negative(self):
         with self.assertRaises(ValueError):
             self.Cache(maxsize=-1)
