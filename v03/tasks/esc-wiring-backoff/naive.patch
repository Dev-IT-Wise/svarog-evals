diff --git a/backoff/_jitter.py b/backoff/_jitter.py
index be7e389..c2bc82b 100644
--- a/backoff/_jitter.py
+++ b/backoff/_jitter.py
@@ -26,3 +26,15 @@ def full_jitter(value: float) -> float:
         value: The unadulterated backoff value.
     """
     return random.uniform(0, value)
+
+
+def equal_jitter(value: float) -> float:
+    """Jitter the value across the upper half of the range (value/2 to value).
+
+    This corresponds to the "Equal Jitter" algorithm specified in the
+    AWS blog's post on the performance of various jitter algorithms.
+
+    Args:
+        value: The unadulterated backoff value.
+    """
+    return value / 2 + random.uniform(0, value / 2)
diff --git a/backoff/_wait_gen.py b/backoff/_wait_gen.py
index 33b37b8..22d6e42 100644
--- a/backoff/_wait_gen.py
+++ b/backoff/_wait_gen.py
@@ -32,6 +32,33 @@ def expo(
             yield max_value
 
 
+def linear(
+    start: float = 1,
+    step: float = 1,
+    max_value: Optional[float] = None
+) -> Generator[float, Any, None]:
+
+    """Generator for linear growth.
+
+    Args:
+        start: The first value to yield.
+        step: The amount added to the value after every yield.
+        max_value: The maximum value to yield. Once the value in the
+             true linear sequence reaches this, the value of max_value
+             will forever after be yielded.
+    """
+    # Advance past initial .send() call
+    yield  # type: ignore[misc]
+    n = 0
+    while True:
+        a = start + step * n
+        if max_value is None or a < max_value:
+            yield a
+            n += 1
+        else:
+            yield max_value
+
+
 def decay(
     initial_value: float = 1,
