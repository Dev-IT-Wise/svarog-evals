         assert i == gen.send(i)
+
+
+def test_linear():
+    gen = backoff.linear()
+    gen.send(None)
+    for i in range(9):
+        assert 1 + i == next(gen)
+
+
+def test_linear_start_step():
+    gen = backoff.linear(start=2, step=3)
+    gen.send(None)
+    for i in range(9):
+        assert 2 + 3 * i == next(gen)
+
+
+def test_linear_max_value():
+    gen = backoff.linear(start=1, step=2, max_value=6)
+    gen.send(None)
+    assert [next(gen) for _ in range(6)] == [1, 3, 5, 6, 6, 6]
