diff --git a/backoff/_jitter.py b/backoff/_jitter.py
index be7e389..c2bc82b 100644
--- a/backoff/_jitter.py
+++ b/backoff/_jitter.py
@@ -26,3 +26,15 @@ def full_jitter(value: float) -> float:
         value: The unadulterated backoff value.
     """
     return random.uniform(0, value)
+
+
+def equal_jitter(value: float) -> float:
+    """Jitter the value across the upper half of the range (value/2 to value).
+
+    This corresponds to the "Equal Jitter" algorithm specified in the
+    AWS blog's post on the performance of various jitter algorithms.
+
+    Args:
+        value: The unadulterated backoff value.
+    """
+    return value / 2 + random.uniform(0, value / 2)
