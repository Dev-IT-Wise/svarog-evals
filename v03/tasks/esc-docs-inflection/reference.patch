+def quantify(count: int, word: str, *, plural: typing.Optional[str] = None) -> str:
+    """
+    Join a count and a noun into a phrase, using the plural form unless the
+    count is 1 or -1. The word is the singular form.
+
+    Examples::
+
+        >>> quantify(1, "apple")
+        '1 apple'
+        >>> quantify(3, "apple")
+        '3 apples'
+        >>> quantify(0, "category")
+        '0 categories'
+        >>> quantify(2, "goose", plural="geese")
+        '2 geese'
+
+    """
+    if not word:
+        return str(count)
+    if abs(count) != 1:
+        word = plural if plural is not None else pluralize(word)
+    return "{} {}".format(count, word)
+
+
