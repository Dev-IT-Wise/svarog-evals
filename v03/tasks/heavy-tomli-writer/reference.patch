+# SPDX-License-Identifier: MIT
+# Licensed to PSF under a Contributor Agreement.
+
+import datetime
+import io
+import unittest
+
+from . import tomllib
+
+
+class TestWrite(unittest.TestCase):
+    def test_round_trip(self):
+        doc = {"a": 1, "b": {"c": [1, 2]}, "d": [{"e": "x"}], "t": datetime.time(1, 2)}
+        self.assertEqual(tomllib.loads(tomllib.dumps(doc)), doc)
+
+    def test_dump_binary(self):
+        f = io.BytesIO()
+        tomllib.dump({"k": "é"}, f)
+        self.assertEqual(f.getvalue(), 'k = "é"\n'.encode())
+
+    def test_errors(self):
+        with self.assertRaisesRegex(tomllib.TOMLEncodeError, "^Object of type NoneType is not TOML serializable$"):
+            tomllib.dumps({"a": None})
+        with self.assertRaisesRegex(tomllib.TOMLEncodeError, "^TOML keys must be strings, not int$"):
+            tomllib.dumps({1: 2})
