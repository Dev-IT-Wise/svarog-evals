+# coding: utf-8
+import os
+from unittest.mock import patch
+
+import pytest
+from decouple import AutoConfig, Config, UndefinedValueError
+
+
+@pytest.fixture(autouse=True)
+def clean_env():
+    with patch.dict(os.environ):
+        yield
+
+
+def test_export_returns_cast_values_and_sets_environment():
+    config = Config({'EXP_PORT': '80'})
+    out = config.export({'EXP_PORT': {'cast': int}, 'EXP_X': {'default': 'x'}})
+    assert out == {'EXP_PORT': 80, 'EXP_X': 'x'}
+    assert os.environ['EXP_PORT'] == '80'
+
+
+def test_export_missing_option_raises():
+    with pytest.raises(UndefinedValueError, match='EXP_B'):
+        Config({}).export({'EXP_B': None})
+
+
+def test_export_bad_cast_raises():
+    with pytest.raises(ValueError):
+        Config({'EXP_N': 'abc'}).export({'EXP_N': {'cast': int}})
+
+
+def test_autoconfig_export(tmp_path):
+    (tmp_path / '.env').write_text('EXP_PORT=9\n')
+    assert AutoConfig(search_path=str(tmp_path)).export({'EXP_PORT': {'cast': int}}) == {'EXP_PORT': 9}
