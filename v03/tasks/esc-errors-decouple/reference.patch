@@ -0,0 +1,57 @@
+# coding: utf-8
+import os
+from unittest.mock import patch
+
+import pytest
+from decouple import AutoConfig, Config, UndefinedValueError
+
+
+@pytest.fixture(autouse=True)
+def clean_env():
+    with patch.dict(os.environ):
+        for key in [k for k in os.environ if k.startswith('EXP_')]:
+            del os.environ[key]
+        yield
+
+
+def test_export_returns_cast_values_and_sets_environment():
+    config = Config({'EXP_PORT': '80', 'EXP_ON': 'yes'})
+    out = config.export({'EXP_PORT': {'cast': int}, 'EXP_ON': {'cast': bool}, 'EXP_X': {'default': 'x'}})
+    assert out == {'EXP_PORT': 80, 'EXP_ON': True, 'EXP_X': 'x'}
+    assert os.environ['EXP_PORT'] == '80'
+    assert os.environ['EXP_ON'] == 'True'
+    assert os.environ['EXP_X'] == 'x'
+
+
+def test_export_keeps_existing_environment_value():
+    os.environ['EXP_ON'] = '1'
+    assert Config({}).export({'EXP_ON': {'cast': bool}}) == {'EXP_ON': True}
+    assert os.environ['EXP_ON'] == '1'
+
+
+def test_export_missing_option_raises_undefined_value_error():
+    before = dict(os.environ)
+    with pytest.raises(UndefinedValueError) as info:
+        Config({'EXP_A': '1'}).export({'EXP_A': None, 'EXP_B': None, 'EXP_C': None})
+    assert 'EXP_B' in str(info.value) and 'EXP_C' in str(info.value)
+    assert dict(os.environ) == before
+
+
+def test_export_bad_cast_names_the_option_and_changes_nothing():
+    before = dict(os.environ)
+    with pytest.raises(ValueError, match='^EXP_N: '):
+        Config({'EXP_A': '1', 'EXP_N': 'abc'}).export({'EXP_A': None, 'EXP_N': {'cast': int}})
+    assert dict(os.environ) == before
+
+
+def test_export_environment_refusal_rolls_back():
+    before = dict(os.environ)
+    with pytest.raises(ValueError, match='^EXP_NUL: '):
+        Config({'EXP_A': '1', 'EXP_NUL': 'a\0b'}).export({'EXP_A': None, 'EXP_NUL': None})
+    assert dict(os.environ) == before
+
+
+def test_autoconfig_export(tmp_path):
+    (tmp_path / '.env').write_text('EXP_PORT=9\n')
+    assert AutoConfig(search_path=str(tmp_path)).export({'EXP_PORT': {'cast': int}}) == {'EXP_PORT': 9}
+    assert os.environ['EXP_PORT'] == '9'
