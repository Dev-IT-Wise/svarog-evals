@@ -106,6 +106,50 @@ class Config(object):
         """
         return self.get(*args, **kwargs)
 
+    def export(self, schema):
+        """
+        Resolve every option of schema and export it to os.environ.
+
+        schema maps an option name to None or to a dict of get() keyword
+        arguments (default, cast). Returns {name: cast value}. All or nothing:
+        on any error os.environ is left exactly as it was.
+        """
+        missing = []
+        raw = {}
+        for name, options in schema.items():
+            kwargs = dict(options or {})
+            kwargs['cast'] = self._cast_do_nothing
+            try:
+                raw[name] = self.get(name, **kwargs)
+            except UndefinedValueError:
+                missing.append(name)
+
+        if missing:
+            raise UndefinedValueError(
+                '{} not found. Declare them as envvars or define default values.'.format(', '.join(missing)))
+
+        values = {}
+        for name, options in schema.items():
+            cast = (options or {}).get('cast', undefined)
+            try:
+                values[name] = self.get(name, default=raw[name], cast=cast)
+            except (ValueError, TypeError) as e:
+                raise ValueError('{}: {}'.format(name, e))
+
+        previous = {}
+        try:
+            for name, value in values.items():
+                if name in os.environ:
+                    continue
+                os.environ[name] = str(value)
+                previous[name] = None
+        except ValueError as e:
+            for done in previous:
+                del os.environ[done]
+            raise ValueError('{}: {}'.format(name, e))
+
+        return values
+
 
