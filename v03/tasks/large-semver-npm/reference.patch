index 0000000..ea44f4d
--- /dev/null
+++ b/src/semver/ranges.py
@@ -0,0 +1,438 @@
+"""
+npm-style version ranges.
+
+A range such as ``^1.2``, ``1.x || >=2.5.0`` or ``1.2.3 - 2.3.4`` is parsed
+into sets of primitive :class:`Comparator` objects. A version is in the
+range when it passes every comparator of at least one set.
+"""
+
+import re
+from typing import Iterable, List, Optional, Tuple, Union
+
+from .version import Version
+
+_OPERATORS = ("<", "<=", ">", ">=", "=", "")
+
+_XR = r"(?:[xX*]|0|[1-9][0-9]*)"
+_PARTIAL = re.compile(
+    r"^v?(%s)(?:\.(%s)(?:\.(%s))?)?(-[0-9A-Za-z.-]*)?(\+[0-9A-Za-z.-]*)?$"
+    % (_XR, _XR, _XR)
+)
+_OPERATOR_SPACE = re.compile(r"(<=|>=|<|>|=|~|\^)\s+")
+_PRIMITIVE = re.compile(r"^(<=|>=|<|>|=)(.*)$")
+
+# A partial version: major, minor, patch (None for an X part) and prerelease.
+_Partial = Tuple[Optional[int], Optional[int], Optional[int], Optional[str]]
+
+
+class InvalidRangeError(ValueError):
+    """Raised when a range expression cannot be parsed."""
+
+
+class Comparator:
+    """One primitive comparison, such as ``>=1.2.0``; ``""`` matches any version."""
+
+    def __init__(self, operator: str, version: Optional[Version]) -> None:
+        """
+        Create a comparator.
+
+        :param operator: one of ``<``, ``<=``, ``>``, ``>=``, ``=`` or ``""``
+        :param version: the version to compare with, ``None`` for ``""``
+        :raises ValueError: if the operator is unknown
+        """
+        if operator not in _OPERATORS:
+            raise ValueError(f"unknown operator {operator!r}")
+        self.operator = operator
+        self.version = version
+
+    def test(self, version: Version) -> bool:
+        """
+        Whether ``version`` passes this comparison, ignoring prerelease rules.
+
+        :param version: the version to test
+        :return: True if it passes
+        """
+        op, v = self.operator, self.version
+        if op == "":
+            return True
+        if op == "=":
+            return version == v
+        if op == "<":
+            return version < v
+        if op == "<=":
+            return version <= v
+        if op == ">":
+            return version > v
+        return version >= v
+
+    def __str__(self) -> str:
+        """Return the comparator as text: ``>=1.2.0``, ``1.2.3`` or ``*``."""
+        if self.operator == "":
+            return "*"
+        if self.operator == "=":
+            return str(self.version)
+        return f"{self.operator}{self.version}"
+
+    def __repr__(self) -> str:
+        """Return ``Comparator(operator, version)``."""
+        return f"Comparator({self.operator!r}, {self.version!r})"
+
+    def __eq__(self, other: object) -> bool:
+        """Two comparators are equal when operator and version are equal."""
+        if not isinstance(other, Comparator):
+            return NotImplemented
+        return (self.operator, self.version) == (other.operator, other.version)
+
+    def __hash__(self) -> int:
+        """Hash by operator and version."""
+        return hash((self.operator, self.version))
+
+
+_ANY = Comparator("", None)
+_NOTHING = Comparator("<", Version(0, 0, 0, "0"))
+
+
+def _below(major: int, minor: int = 0, patch: int = 0) -> Comparator:
+    """``<M.m.p-0``: excludes ``M.m.p`` and all of its prereleases."""
+    return Comparator("<", Version(major, minor, patch, "0"))
+
+
+def _parse_partial(text: str, token: str, expr: str) -> _Partial:
+    """Parse a partial version; ``token`` and ``expr`` are for error messages."""
+    match = _PARTIAL.match(text)
+    if match is None:
+        raise InvalidRangeError(f"invalid comparator {token!r} in range {expr!r}")
+    raw = match.group(1, 2, 3)
+    pre, build = match.group(4, 5)
+    parts = [None if p is None or p in "xX*" else int(p) for p in raw]
+    for i in (1, 2):
+        if parts[i] is not None and parts[i - 1] is None:
+            raise InvalidRangeError(
+                f"invalid comparator {token!r} in range {expr!r}"
+            )
+    if (pre or build) and parts[2] is None:
+        raise InvalidRangeError(f"prerelease on a partial version in range {expr!r}")
+    if parts[2] is not None:
+        # Let Version apply SemVer's rules for prerelease and build.
+        full = "%d.%d.%d%s%s" % (parts[0], parts[1], parts[2], pre or "", build or "")
+        try:
+            pre = Version.parse(full).prerelease
+        except ValueError:
+            raise InvalidRangeError(
+                f"invalid comparator {token!r} in range {expr!r}"
+            ) from None
+    return parts[0], parts[1], parts[2], pre
+
+
+def _xrange(operator: str, partial: _Partial) -> List[Comparator]:
+    """Expand a primitive or a bare partial (operator ``"="``)."""
+    major, minor, patch, pre = partial
+    if patch is not None:
+        return [Comparator(operator, Version(major, minor, patch, pre))]
+    if major is None:
+        return [_NOTHING] if operator in ("<", ">") else [_ANY]
+    lower = Version(major, minor or 0, 0)
+    if minor is None:
+        upper = _below(major + 1)
+    else:
+        upper = _below(major, minor + 1)
+    if operator == "=":
+        return [Comparator(">=", lower), upper]
+    if operator == ">":
+        return [Comparator(">=", upper.version.replace(prerelease=None))]
+    if operator == ">=":
+        return [Comparator(">=", lower)]
+    if operator == "<":
+        return [Comparator("<", lower.replace(prerelease="0"))]
+    return [upper]
+
+
+def _tilde(partial: _Partial) -> List[Comparator]:
+    """Expand ``~partial``: patch-level changes, or minor if no minor is given."""
+    major, minor, patch, pre = partial
+    if major is None:
+        return [_ANY]
+    lower = Comparator(">=", Version(major, minor or 0, patch or 0, pre))
+    if minor is None:
+        return [lower, _below(major + 1)]
+    return [lower, _below(major, minor + 1)]
+
+
+def _caret(partial: _Partial) -> List[Comparator]:
+    """Expand ``^partial``: changes that keep the left-most non-zero part."""
+    major, minor, patch, pre = partial
+    if major is None:
+        return [_ANY]
+    lower = Comparator(">=", Version(major, minor or 0, patch or 0, pre))
+    if minor is None or major > 0:
+        return [lower, _below(major + 1)]
+    if patch is None or minor > 0:
+        return [lower, _below(0, minor + 1)]
+    return [lower, _below(0, 0, patch + 1)]
+
+
+def _hyphen(low: _Partial, high: _Partial) -> List[Comparator]:
+    """Expand ``low - high`` into an inclusive range."""
+    result = []
+    if low[0] is not None:
+        result.append(
+            Comparator(">=", Version(low[0], low[1] or 0, low[2] or 0, low[3]))
+        )
+    major, minor, patch, pre = high
+    if major is not None:
+        if minor is None:
+            result.append(_below(major + 1))
+        elif patch is None:
+            result.append(_below(major, minor + 1))
+        else:
+            result.append(Comparator("<=", Version(major, minor, patch, pre)))
+    return result or [_ANY]
+
+
+def _parse_set(text: str, expr: str) -> Tuple[Comparator, ...]:
+    """Parse one ``||`` alternative into its comparators."""
+    tokens = _OPERATOR_SPACE.sub(r"\1", text).split()
+    if not tokens:
+        return (_ANY,)
+    if "-" in tokens:
+        if len(tokens) != 3 or tokens[1] != "-":
+            raise InvalidRangeError(f"incomplete hyphen range in range {expr!r}")
+        comparators = _hyphen(
+            _parse_partial(tokens[0], tokens[0], expr),
+            _parse_partial(tokens[2], tokens[2], expr),
+        )
+    else:
+        comparators = []
+        for token in tokens:
+            if token[0] in "~^":
+                partial = _parse_partial(token[1:], token, expr)
+                comparators += _tilde(partial) if token[0] == "~" else _caret(partial)
+                continue
+            match = _PRIMITIVE.match(token)
+            operator, rest = match.groups() if match else ("=", token)
+            comparators += _xrange(operator, _parse_partial(rest, token, expr))
+    # As npm does: a set holding the null set is just that, duplicates go,
+    # and "*" is dropped when the set has other comparators.
+    if _NOTHING in comparators:
+        return (_NOTHING,)
+    unique = list(dict.fromkeys(comparators))
+    if len(unique) > 1 and _ANY in unique:
+        unique.remove(_ANY)
+    return tuple(unique)
+
+
+def _to_version(version: Union[Version, str]) -> Version:
+    """Return ``version`` as a Version, parsing a str."""
+    if isinstance(version, Version):
+        return version
+    if isinstance(version, str):
+        return Version.parse(version)
+    raise TypeError(f"expected Version or str, not {type(version).__name__}")
+
+
+def _set_contains(
+    comparators: Iterable[Comparator], version: Version, include_prerelease: bool
+) -> bool:
+    """Whether one set contains ``version``, with the prerelease rule."""
+    comparators = list(comparators)
+    if not all(c.test(version) for c in comparators):
+        return False
+    if not version.prerelease or include_prerelease:
+        return True
+    # An added "<V-0" upper bound can never let a prerelease of V through,
+    # so it needs no special case here.
+    return any(
+        c.version is not None
+        and c.version.prerelease
+        and c.version.to_tuple()[:3] == version.to_tuple()[:3]
+        for c in comparators
+    )
+
+
+def _successor(version: Version, exact: bool) -> Version:
+    """
+    The version right after ``version``.
+
+    With ``exact``, the true successor in SemVer order (``1.2.4-0`` after
+    ``1.2.3``); otherwise the one ``min_version`` uses (``1.2.4``).
+    """
+    if version.prerelease:
+        return version.replace(prerelease=version.prerelease + ".0", build=None)
+    return Version(version.major, version.minor, version.patch + 1, "0" if exact else None)
+
+
+class Range:
+    """An npm-style version range, such as ``^1.2`` or ``1.x || >=2.5.0``."""
+
+    def __init__(self, expression: str) -> None:
+        """
+        Parse a range expression.
+
+        :param expression: the range, for example ``>=1.0.0 <2.0.0``
+        :raises TypeError: if ``expression`` is not a str
+        :raises InvalidRangeError: if ``expression`` is invalid
+        """
+        if not isinstance(expression, str):
+            raise TypeError(
+                f"range expression must be a str, not {type(expression).__name__}"
+            )
+        self.expression = expression
+        self.sets = tuple(
+            _parse_set(part, expression) for part in expression.split("||")
+        )
+
+    def contains(
+        self, version: Union[Version, str], *, include_prerelease: bool = False
+    ) -> bool:
+        """
+        Whether the range contains ``version``.
+
+        :param version: a Version or a version string
+        :param include_prerelease: treat prereleases like any other version
+        :return: True if some set contains the version
+        :raises TypeError: if ``version`` is neither a Version nor a str
+        :raises ValueError: if ``version`` is an invalid version string
+        """
+        version = _to_version(version)
+        return any(_set_contains(s, version, include_prerelease) for s in self.sets)
+
+    def __contains__(self, version: Union[Version, str]) -> bool:
+        """``version in rng`` is ``rng.contains(version)``."""
+        return self.contains(version)
+
+    def filter(
+        self,
+        versions: Iterable[Union[Version, str]],
+        *,
+        include_prerelease: bool = False,
+    ) -> List[Version]:
+        """
+        Return the contained versions, in input order, duplicates kept.
+
+        :param versions: Versions or version strings
+        :param include_prerelease: treat prereleases like any other version
+        :return: the contained versions as Version objects
+        """
+        result = []
+        for item in versions:
+            version = _to_version(item)
+            if self.contains(version, include_prerelease=include_prerelease):
+                result.append(version)
+        return result
+
+    def max_satisfying(
+        self,
+        versions: Iterable[Union[Version, str]],
+        *,
+        include_prerelease: bool = False,
+    ) -> Optional[Version]:
+        """
+        Return the highest contained version, or None.
+
+        :param versions: Versions or version strings
+        :param include_prerelease: treat prereleases like any other version
+        :return: the highest contained version, None if there is none
+        """
+        found = self.filter(versions, include_prerelease=include_prerelease)
+        return max(found) if found else None
+
+    def min_satisfying(
+        self,
+        versions: Iterable[Union[Version, str]],
+        *,
+        include_prerelease: bool = False,
+    ) -> Optional[Version]:
+        """
+        Return the lowest contained version, or None.
+
+        :param versions: Versions or version strings
+        :param include_prerelease: treat prereleases like any other version
+        :return: the lowest contained version, None if there is none
+        """
+        found = self.filter(versions, include_prerelease=include_prerelease)
+        return min(found) if found else None
+
+    def min_version(self) -> Optional[Version]:
+        """
+        Return the lowest version the range allows, prereleases included.
+
+        The candidates are ``0.0.0``, every comparator's version and, for
+        every ``>V``, the version right after ``V``.
+
+        :return: the lowest contained candidate, None if there is none
+        """
+        candidates = [Version(0, 0, 0)]
+        for comparators in self.sets:
+            for c in comparators:
+                if c.version is not None:
+                    candidates.append(c.version)
+                    if c.operator == ">":
+                        candidates.append(_successor(c.version, exact=False))
+        found = [v for v in candidates if self.contains(v, include_prerelease=True)]
+        return min(found) if found else None
+
+    def intersects(self, other: Union["Range", str]) -> bool:
+        """
+        Whether some version, prereleases included, is in both ranges.
+
+        :param other: a Range or a range expression
+        :return: True if the ranges overlap
+        :raises TypeError: if ``other`` is neither a Range nor a str
+        """
+        if isinstance(other, str):
+            other = Range(other)
+        elif not isinstance(other, Range):
+            raise TypeError(f"expected Range or str, not {type(other).__name__}")
+        for mine in self.sets:
+            for theirs in other.sets:
+                both = mine + theirs
+                # The lowest version both sets allow, if any, is one of these.
+                candidates = [Version(0, 0, 0, "0")]
+                for c in both:
+                    if c.version is not None:
+                        candidates.append(c.version)
+                        if c.operator == ">":
+                            candidates.append(_successor(c.version, exact=True))
+                if any(all(c.test(v) for c in both) for v in candidates):
+                    return True
+        return False
+
+    def __str__(self) -> str:
+        """Return the normalised range, for example ``>=1.2.0 <2.0.0-0``."""
+        return " || ".join(" ".join(str(c) for c in s) for s in self.sets)
+
+    def __repr__(self) -> str:
+        """Return ``Range('<expression>')``."""
+        return f"Range({self.expression!r})"
+
+    def __eq__(self, other: object) -> bool:
+        """Two ranges are equal when their sets are equal."""
+        if not isinstance(other, Range):
+            return NotImplemented
+        return self.sets == other.sets
+
+    def __hash__(self) -> int:
+        """Hash by the parsed sets."""
+        return hash(self.sets)
+
+
+def satisfies(
+    version: Union[Version, str],
+    range_expr: Union[Range, str],
+    *,
+    include_prerelease: bool = False,
+) -> bool:
+    """
+    Whether ``version`` is in the range ``range_expr``.
+
+    :param version: a Version or a version string
+    :param range_expr: a Range or a range expression
+    :param include_prerelease: treat prereleases like any other version
+    :return: True if the range contains the version
+
+    >>> satisfies("1.4.0", "^1.2")
+    True
+    """
+    if not isinstance(range_expr, Range):
+        range_expr = Range(range_expr)
+    return range_expr.contains(version, include_prerelease=include_prerelease)
