diff --git a/tests/test_partial_operands.py b/tests/test_partial_operands.py
new file mode 100644
index 0000000..a1e1f96
--- /dev/null
+++ b/tests/test_partial_operands.py
@@ -0,0 +1,72 @@
+# SPDX-License-Identifier: MIT
+import pytest
+
+from semver import Version
+
+
+@pytest.mark.parametrize(
+    "left,right,expected",
+    [
+        ("1.2.0", "1.2", 0),
+        ("1.0.0", "1", 0),
+        ("1.2.3", "1.2", 1),
+        ("1.1.9", "1.2", -1),
+        ("2.0.0", "1", 1),
+        ("1.2.0-rc.1", "1.2", -1),
+        ("1.2.0-rc.1", "1.2-rc.1", 0),
+        ("1.2.0+build.1", "1.2+build.2", 0),
+    ],
+)
+def test_compare_short_operand(left, right, expected):
+    assert Version.parse(left).compare(right) == expected
+    assert Version.parse(left).compare(right.encode()) == expected
+
+
+@pytest.mark.parametrize(
+    "op,expected",
+    [
+        ("==", True), ("!=", False), ("<", False), ("<=", True), (">", False), (">=", True),
+    ],
+)
+def test_operators_short_operand(op, expected):
+    left = Version.parse("1.2.0")
+    assert eval("left %s '1.2'" % op) is expected
+    assert eval("'1.2' %s left" % op) is expected
+
+
+@pytest.mark.parametrize(
+    "version,expr,expected",
+    [
+        ("1.2.3", ">=1.2", True),
+        ("1.2.3", "<2", True),
+        ("1.2.3", "<1.2", False),
+        ("1.2.0", "1.2", True),
+        ("1.2.3", "1.2", False),
+        ("1.2.3", "!=2", True),
+        ("2.0.0", "==2", True),
+        ("2.0.0", "<=2", True),
+        ("2.0.1", "<=2", False),
+    ],
+)
+def test_match_short_operand(version, expr, expected):
+    assert Version.parse(version).match(expr) is expected
+
+
+@pytest.mark.parametrize("operand", ["", "garbage", "1.", "1.2.3.4", "01.2.3", "1.2.x", "v1.2"])
+def test_invalid_operand_message_unchanged(operand):
+    with pytest.raises(ValueError, match="is not valid SemVer string"):
+        Version.parse("1.2.3").compare(operand)
+
+
+def test_parse_and_is_valid_stay_strict():
+    with pytest.raises(ValueError):
+        Version.parse("1.2")
+    assert not Version.is_valid("1.2")
+
+
+def test_subclass_without_override():
+    class Sub(Version):
+        pass
+
+    assert Sub.parse("1.2.0").compare("1.2") == 0
+    assert Sub.parse("1.2.3").match(">=1.2")
