+"""Version ranges such as ``^1.2.3`` or ``>=1.0.0, <2.0.0``."""
+
+from typing import Iterable, List, Optional, Tuple, Union
+
+from .version import Version
+
+_OPERATORS = (">=", "<=", "==", "!=", "^", "~", ">", "<")
+_CHECKS = {
+    ">=": lambda c: c >= 0,
+    "<=": lambda c: c <= 0,
+    ">": lambda c: c > 0,
+    "<": lambda c: c < 0,
+    "==": lambda c: c == 0,
+    "!=": lambda c: c != 0,
+}
+
+_Comparator = Tuple[str, Version]
+
+
+class InvalidRangeError(ValueError):
+    """A version range expression could not be parsed."""
+
+
+def _expand(op: str, v: Version) -> List[_Comparator]:
+    if op == "^":
+        if v.major:
+            upper = Version(v.major + 1)
+        elif v.minor:
+            upper = Version(0, v.minor + 1)
+        else:
+            upper = Version(0, 0, v.patch + 1)
+        return [(">=", v), ("<", upper)]
+    if op == "~":
+        return [(">=", v), ("<", Version(v.major, v.minor + 1))]
+    return [(op, v)]
+
+
+def _parse_comparator(text: str, expression: str) -> List[_Comparator]:
+    comp = text.strip()
+    if not comp:
+        raise InvalidRangeError("empty comparator in range %r" % expression)
+    op = next((o for o in _OPERATORS if comp.startswith(o)), "")
+    try:
+        version = Version.parse(comp[len(op):].strip())
+    except (ValueError, TypeError):
+        raise InvalidRangeError("invalid comparator %r in range %r" % (comp, expression)) from None
+    return _expand(op or "==", version)
+
+
+class VersionRange:
+    """A set of versions, written as an npm-style range expression.
+
+    >>> VersionRange("^1.2.3").contains("1.9.0")
+    True
+    """
+
+    def __init__(self, expression: str) -> None:
+        if not isinstance(expression, str):
+            raise TypeError("range expression must be a str, not %s" % type(expression).__name__)
+        if not expression.strip():
+            raise InvalidRangeError("empty range expression")
+        self.expression = expression
+        self._groups = [
+            [c for part in group.split(",") for c in _parse_comparator(part, expression)]
+            for group in expression.split("||")
+        ]
+
+    def __repr__(self) -> str:
+        return "VersionRange(%r)" % self.expression
+
+    def __str__(self) -> str:
+        return self.expression
+
+    def __contains__(self, version: Union[Version, str]) -> bool:
+        return self.contains(version)
+
+    def contains(self, version: Union[Version, str], *, include_prerelease: bool = False) -> bool:
+        """Whether `version` is in this range.
+
+        >>> VersionRange(">=1.0.0, <2.0.0").contains("2.0.0")
+        False
+        """
+        if isinstance(version, str):
+            version = Version.parse(version)
+        elif not isinstance(version, Version):
+            raise TypeError("expected Version or str, not %s" % type(version).__name__)
+        return any(self._group_contains(g, version, include_prerelease) for g in self._groups)
+
+    @staticmethod
+    def _group_contains(group: List[_Comparator], v: Version, include_prerelease: bool) -> bool:
+        if not all(_CHECKS[op](v.compare(bound)) for op, bound in group):
+            return False
+        if v.prerelease is None or include_prerelease:
+            return True
+        return any(b.prerelease is not None and b.to_tuple()[:3] == v.to_tuple()[:3] for _, b in group)
+
+    def max_satisfying(
+        self, versions: Iterable[Union[Version, str]], *, include_prerelease: bool = False
+    ) -> Optional[Version]:
+        """The highest of `versions` in this range, or None.
+
+        >>> VersionRange("~1.2.0").max_satisfying(["1.2.5", "1.3.0"])
+        Version(major=1, minor=2, patch=5, prerelease=None, build=None)
+        """
+        found = None
+        for v in versions:
+            v = Version.parse(v) if isinstance(v, str) else v
+            if self.contains(v, include_prerelease=include_prerelease) and (found is None or v > found):
+                found = v
+        return found
