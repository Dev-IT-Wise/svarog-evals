@@ -0,0 +1,28 @@
+import pytest
+
+from semver import InvalidRangeError, Version, VersionRange
+
+
+@pytest.mark.parametrize(
+    "expression,version,expected",
+    [
+        ("^1.2.3", "1.9.9", True),
+        ("^1.2.3", "2.0.0", False),
+        ("~1.2.3", "1.3.0", False),
+        (">=1.0.0, <2.0.0 || 3.0.0", "3.0.0", True),
+        ("^1.2.3", "1.5.0-beta.1", False),
+        (">=1.2.3-alpha.3", "1.2.3-alpha.7", True),
+    ],
+)
+def test_contains(expression, version, expected):
+    assert VersionRange(expression).contains(version) is expected
+
+
+def test_max_satisfying():
+    assert VersionRange("^1.0.0").max_satisfying(["1.0.0", "1.4.0", "2.0.0"]) == Version(1, 4)
+
+
+@pytest.mark.parametrize("expression", ["", ">=1.0.0,", "^1.2"])
+def test_invalid(expression):
+    with pytest.raises(InvalidRangeError):
+        VersionRange(expression)
